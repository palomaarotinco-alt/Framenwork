<style id="crss-styles-inline-css">

      .crss-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:24px;margin:25px 0;box-sizing:border-box}
      .crss-card{background:#fff;border:1px solid #e5e7eb;border-radius:10px;overflow:hidden;display:flex;flex-direction:column;box-shadow:0 4px 6px -1px rgba(0,0,0,.05);transition:transform .2s ease,box-shadow .2s ease}
      .crss-card:hover{transform:translateY(-4px);box-shadow:0 10px 15px -3px rgba(0,0,0,.08)}
      .crss-img-box{width:100%;aspect-ratio:16/9;background-color:#f3f4f6;overflow:hidden}
      .crss-img{width:100%;height:100%;object-fit:cover;display:block}
      .crss-body{padding:18px;display:flex;flex-direction:column;flex-grow:1}
      .crss-date{font-size:.78rem;color:#6b7280;margin-bottom:8px;font-weight:500}
      .crss-title{font-size:1.05rem;font-weight:700;line-height:1.35;margin:0 0 10px}
      .crss-title a{color:#111827;text-decoration:none}
      .crss-title a:hover{color:#0056b3}
      .crss-desc{font-size:.88rem;color:#4b5563;line-height:1.5;margin:0 0 16px;flex-grow:1}
      .crss-btn{align-self:flex-start;font-size:.85rem;font-weight:700;color:#0056b3;text-decoration:none}
      .crss-btn:hover{text-decoration:underline}
      .crss-msg{color:#6b7280;font-style:italic}
      .crss-pagination{display:flex;gap:8px;justify-content:center;margin:20px 0}
      .crss-page{padding:6px 12px;border:1px solid #e5e7eb;border-radius:6px;text-decoration:none;color:#111827;font-size:.9rem}
      .crss-page:hover{background:#f3f4f6}
      .crss-page.is-current{background:#0056b3;color:#fff;border-color:#0056b3;font-weight:700}
    
/*# sourceURL=crss-styles-inline-css */
</style>
